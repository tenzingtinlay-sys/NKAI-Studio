FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=7862

RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements-indic-parler.txt .
RUN pip install --no-cache-dir -r requirements-indic-parler.txt
COPY indic_parler_app.py .

EXPOSE 7862
CMD ["sh", "-c", "uvicorn indic_parler_app:app --host 0.0.0.0 --port ${PORT}"]
