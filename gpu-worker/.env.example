# Copy these settings into your GPU host's secret/environment manager.
# Do not commit real values or expose them through VITE_* browser variables.

# Required for deployed worker API authentication.
WORKER_API_TOKEN=replace-with-a-long-random-secret

# Optional: model and runtime settings.
MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
MAX_NEW_TOKENS=240
PORT=7860

# Prefer explicit Studio origins instead of wildcard CORS when browser access
# to the worker is needed. The NKAI same-origin gateway normally proxies calls.
CORS_ORIGINS=https://your-nkai-studio-domain.example

# Studio server-side secrets (configure in the Studio host, not this worker):
# AI_WORKER_INTERNAL_URL=https://your-worker-host.example
# AI_WORKER_API_TOKEN=the-same-value-as-WORKER_API_TOKEN
# AI_WORKER_PLATFORM=lightning-ai
#
# Multi-provider alternative on the Studio server:
# AI_GPU_WORKERS=[{"id":"lightning-primary","platform":"lightning-ai","baseUrl":"https://worker-a.example","token":"secret-a","priority":0},{"id":"backup","platform":"huggingface","baseUrl":"https://worker-b.example","token":"secret-b","priority":1}]
