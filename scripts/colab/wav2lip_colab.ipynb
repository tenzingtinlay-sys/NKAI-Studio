   "source": [
    "# Wav2Lip batch generator + forced-alignment + push\n",
    "\n",
    "Run this notebook in Google Colab (Runtime -> Change runtime type -> GPU). Follow cells in order.\n",
    "**Security**: When prompted to paste a GitHub token, paste it into the Colab input cell only; do not share it here.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Install system deps and Python libs\n",
    "!apt-get update -y && apt-get install -y ffmpeg git python3-dev python3-pip && pip install pydub praat-parselmouth textgrid PyGithub"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Clone Wav2Lip and download weights\n",
    "!git clone https://github.com/Rudrabha/Wav2Lip.git /content/Wav2Lip || true\n",
    "!wget -q \"https://storage.googleapis.com/pyannote/weights/wav2lip_gan.pth\" -O /content/wav2lip_gan.pth || true\n",
    "!pip install -r /content/Wav2Lip/requirements.txt || true"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Option A: Clone your repo (public)\n",
    "!git clone https://github.com/tenzingtinlay-sys/NKAI-Studio.git /content/NKAI-Studio || echo 'Clone failed (private repo?)'\n",
    "# Option B: If repo is private, mount Drive or upload vendor files instead\n",
    "from google.colab import drive\n",
    "print('If your repo is private, run drive.mount and copy vendor folder into /content/NKAI-Studio/vendor')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Batch-run Wav2Lip over vendor Audio files (example loop). Adjust paths if needed.\n",
    "import glob, os, shlex\n",
    "audios = glob.glob('/content/NKAI-Studio/vendor/**/Audio/*.wav', recursive=True)\n",
    "print('Found', len(audios), 'audio files')\n",
    "os.makedirs('/content/wav2lip_out', exist_ok=True)\n",
    "for a in audios[:100]:  # limit in notebook run; remove [:100] to process all\n",
    "  base = os.path.splitext(os.path.basename(a))[0]\n",
    "  # find a face image candidate\n",
    "  candidates = glob.glob(f'/content/NKAI-Studio/vendor/**/WebP/{base}*.webp', recursive=True)\n",
    "  if not candidates:\n",
    "    candidates = glob.glob(f'/content/NKAI-Studio/vendor/**/PNG/*{base}*.png', recursive=True)\n",
    "  if not candidates:\n",
    "    candidates = glob.glob(f'/content/NKAI-Studio/vendor/**/JPEG/*{base}*.jpg', recursive=True)\n",
    "  if not candidates:\n",
    "    print('no face for', base); continue\n",
    "  face = candidates[0]\n",
    "  out = f'/content/wav2lip_out/{base}.mp4'\n",
    "  cmd = f'python /content/Wav2Lip/inference.py --checkpoint_path /content/wav2lip_gan.pth --face {shlex.quote(face)} --audio {shlex.quote(a)} --outfile {shlex.quote(out)}'\n",
    "  print('Running', base)\n",
    "  os.system(cmd)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Forced-alignment step is environment-specific. If you have MFA, run it here to produce phoneme timings.\n",
    "print('If you have Montreal Forced Aligner installed, run it here and then use phoneme_to_viseme.py to convert timings to .viseme.json')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Copy outputs into repo path and push to GitHub (interactive token paste)\n",
    "import os, getpass\n",
    "os.makedirs('/content/NKAI-Studio/public/vendor/370-avatars-and-users-library/370+ avatars and users library – Untitled UI/Videos', exist_ok=True)\n",
    "!cp /content/wav2lip_out/*.mp4 '/content/NKAI-Studio/public/vendor/370-avatars-and-users-library/370+ avatars and users library – Untitled UI/Videos/' || true\n",
    "!cp /content/wav2lip_out/*.viseme.json '/content/NKAI-Studio/public/vendor/370-avatars-and-users-library/370+ avatars and users library – Untitled UI/Videos/' || true\n",
    "%bash\n",
    "read -s -p 'Paste GITHUB_TOKEN (will not echo): ' GHTOKEN\n",
    "git -C /content/NKAI-Studio config user.email 'you@example.com'\n",
    "git -C /content/NKAI-Studio config user.name 'Colab User'\n",
    "BRANCH=add/wav2lip-results-$(date +%s)\n",
    "git -C /content/NKAI-Studio checkout -b $BRANCH\n",
    "git -C /content/NKAI-Studio add public/vendor/370-avatars-and-users-library/** || true\n",
    "git -C /content/NKAI-Studio commit -m 'Add Wav2Lip-generated videos and viseme manifests' || true\n",
    "git -C /content/NKAI-Studio remote set-url origin "https://oauth2:${GHTOKEN}@github.com/tenzingtinlay-sys/NKAI-Studio.git"\n",
    "git -C /content/NKAI-Studio push -u origin $BRANCH\n",
    "echo 'Pushed branch' $BRANCH\n"
   ]
  }
