# Optional upstream git ref; pin to a reviewed commit for reproducible deployments.
LIVETALKING_REF=main

# Directories on the Linux GPU host containing the upstream-required assets.
# Add wav2lip.pth to models/ and the wav2lip256_avatar1 avatar directory to avatars/.
LIVETALKING_MODELS_DIR=./models
LIVETALKING_AVATARS_DIR=./avatars
