# Copy this file to .env and adjust paths/ports for your host.
# Linux host with Docker Compose v2, NVIDIA driver, and NVIDIA Container Toolkit required.
# Use an absolute path for DUIX_DATA_DIR on Linux. Keep all service ports loopback-only.
DUIX_DATA_DIR=./data
DUIX_NVIDIA_VISIBLE_DEVICES=all
DUIX_TTS_PORT=18180
DUIX_ASR_PORT=10095
DUIX_VIDEO_PORT=8383
