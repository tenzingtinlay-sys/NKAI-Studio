# Copy to .env locally and replace the token with a long random secret.
# Never commit the real .env file.
WORKER_API_TOKEN=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:8080
MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
DOWNLOAD_OPENVOICE_CHECKPOINTS=true
OPENVOICE_CHECKPOINTS_DIR=./openvoice-checkpoints
VOICE_REFERENCE_FILE=./voice-secrets/voice-reference.wav

# Private LiveTalking service reachable by the app server (never expose this URL in browser config).
LIVETALKING_INTERNAL_URL=http://127.0.0.1:8010

# Private open-source AI worker; configure on the server/deployment only.
AI_WORKER_INTERNAL_URL=http://127.0.0.1:8000
# Optional: must match WORKER_API_TOKEN on gpu-worker.
AI_WORKER_API_TOKEN=

# Optional dedicated neural TTS worker (e.g. a separately deployed OpenVoice V2 service).
# When set, /api/ai/tts routes here instead of the chat worker. Keep both values server-side.
AI_TTS_INTERNAL_URL=
AI_TTS_API_TOKEN=

# Optional timed worker pool (server-side only). Configure only approved endpoints.
# AI_WORKER_POOL_JSON must be a JSON array; each entry needs id, platform, baseUrl,
# token, leaseHours, priority, and liveServingAllowed=true. Never put this in VITE_*.
# Google Colab and Kaggle are deliberately excluded from live worker routing.
